    {
      "id": "duel_stages_challenge_2026-04-17",
      "nombre": "Duel Stages Challenge",
      "caracteristicas": [
        "It's high noon, time for a showdown!\nDuel Stages Challenge (\u6c7a\u95d8\u30c1\u30e3\u30ec\u30f3\u30b8, Kett\u014d Charenji, Duel Challenge) is an event added in Version 11.6. It consists of all Duel Stages in a single map. Progress made in Duel Stages Challenge will reset when the event ends.\nEach stage has a Cat Deploy Limit and enemy limit of 1. Taking over 15 minutes to beat any one stage will cause an Assassin Bear to spawn."
      ],
      "fecha_inicio": "2026-04-17",
      "fecha_fin": "2026-04-27"
    },
